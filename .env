# ── Configuracion de Supabase ──────────────────────────────────
# Este archivo contiene las credenciales para conectar con tu
# proyecto de Supabase en la nube.
#
# IMPORTANTE:
#   - Este archivo NO se sube a git (esta en .gitignore)
#   - Nunca compartas la service_role key en el frontend
#   - La anon key es PUBLICA y segura (la protege el RLS)
#
# COMO OBTENER estos valores:
#   1. Ve a https://supabase.com y entra a tu proyecto
#   2. Ve a Project Settings → API
#   3. Copia "Project URL" y ponlo en VITE_SUPABASE_URL
#   4. Copia "anon public" key y ponlo en VITE_SUPABASE_ANON_KEY
#   5. Copia "service_role" key y ponlo en SUPABASE_SERVICE_ROLE_KEY
#      (esta solo se usa en Edge Functions, NUNCA en el frontend)

# URL de tu proyecto Supabase (la obtienes del dashboard)
VITE_SUPABASE_URL=https://euqlrngxpcqtrouqxvfi.supabase.co

# Clave publica de Supabase (segura para usar en el frontend)
VITE_SUPABASE_ANON_KEY=sb_publishable_WAmkq-fM4hqjesrR5jaNqw_t6nm82HA

# Clave secreta de service role (SOLO para Edge Functions, NO para el frontend)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
